<Window x:Class="tpkursa4.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="190" Width="350" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F5F5F7">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Идентификация пользователя" Grid.Row="0"
                   FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Введите ваш логин (username):" Margin="0,0,0,5" Foreground="Gray"/>
            <TextBox x:Name="txtUsername" Height="28" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Войти" x:Name="btnLogin" Width="80" Height="30" 
                    IsDefault="True" Click="BtnLogin_Click" Margin="0,0,10,0"/>
            <Button Content="Отмена" x:Name="btnCancel" Width="80" Height="30" 
                    IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>